{
  "name": "waffle-map",
  "version": "2.0.0",
  "description": "Fantastic mesh renderer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check --write .",
    "check:docs": "node scripts/check-docs-sync.mjs",
    "check:comments": "node scripts/check-no-comments.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:property": "vitest --run src/domain/__tests__/*.property.test.ts",
    "test:mutation": "node scripts/mutator.mjs",
    "test:mutation:diff": "node scripts/mutator.mjs --since origin/main",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && npm run test:e2e",
    "typecheck": "tsc -p . --noEmit"
  },
  "author": "dorayakikun <github@dorayakikun.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dorayakikun/waffle-map.git"
  },
  "homepage": "https://waffle-map.netlify.app/",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "fast-check": "^4.11.0",
    "jsdom": "^31.0.1",
    "oxc-parser": "^0.159.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.38.0",
    "@emotion/react": "^11.14.0",
    "@resvg/resvg-js": "^2.6.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "waffle-map-mesh-calculator-basic": "github:dorayakikun/waffle-map-mesh-calculator-basic#ee66cc18785d308390b8ed1c2dd0d553ac93528a",
    "zustand": "^5.1.0"
  }
}
